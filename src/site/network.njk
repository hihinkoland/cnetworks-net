---
permalink: /network/
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Network View</title>
  <script src="https://unpkg.com/d3-force@3"></script>
  <script src="https://unpkg.com/force-graph"></script>
  <style>
    body { margin: 0; background: #1e1e1e; color: #dcddde; font-family: sans-serif; overflow: hidden; }
    #graph { width: 100vw; height: 100vh; }
    #controls {
      position: fixed; top: 16px; left: 16px; z-index: 10;
      background: #262626; padding: 14px; border-radius: 8px;
      border: 1px solid #363636; width: 220px; font-size: 13px;
      max-height: calc(100vh - 32px); overflow-y: auto;
    }
    #controls label { display: block; margin-top: 10px; }
    #controls input[type="range"] { width: 100%; }
    #controls input[type="checkbox"] { width: auto; margin-right: 6px; }
    #controls select { box-sizing: border-box; width: 100%; margin-top: 4px; padding: 4px; }
    a.back { color: #8b5cf6; text-decoration: none; font-weight: bold; }
    #node-info {
      position: fixed; top: 16px; right: 16px; z-index: 11;
      box-sizing: border-box; max-width: min(320px, calc(100vw - 32px));
      max-height: calc(100vh - 32px); overflow-y: auto;
      padding: 12px 16px; border: 1px solid #363636; border-radius: 8px;
      background: #262626; color: #dcddde; box-shadow: 0 4px 16px #0008;
      pointer-events: none;
    }
    #node-info h2 { margin: 0; font-size: 15px; }
    #node-info ul { margin: 8px 0 0; padding-left: 18px; font-size: 13px; }
    #graph-coordinates {
      position: fixed; right: 16px; bottom: 16px; z-index: 11;
      padding: 6px 10px; border: 1px solid #363636; border-radius: 6px;
      background: #262626; color: #dcddde; font: 12px monospace;
      font-variant-numeric: tabular-nums; pointer-events: none;
    }
  </style>
</head>
<body>
  <div id="controls">
    <a class="back" href="/">← Back to Notes</a>
    <h3 style="margin: 8px 0 4px;">Physics Controls</h3>
    <label>Repel Force: <span id="repelVal">-100</span>
      <input type="range" id="repel" min="0" max="250" step="any" value="100">
    </label>
    <label>Link Strength: <span id="linkStrengthVal">0.3</span>
      <input type="range" id="linkStrength" min="0" max="2" step="0.01" value="0.3">
    </label>
    <label>Link Distance: <span id="distVal">25</span>
      <input type="range" id="dist" min="10" max="500" value="25">
    </label>
    <label>Center Gravity: <span id="centerVal">0.03</span>
      <input type="range" id="center" min="0" max="1" step="any" value="0.03">
    </label>
    <label>Grouping Force: <span id="groupingForceVal">0.1</span>
      <input type="range" id="groupingForce" min="0" max="1" step="0.01" value="0.1">
    </label>
    <label for="groupingMode">Grouping Mode
      <select id="groupingMode">
        <option value="point" selected>point</option>
        <option value="node">node</option>
        <option value="none">none</option>
      </select>
    </label>
    <label><input type="checkbox" id="showGroupAnchors" checked> Show grouping anchors</label>
  </div>
  <aside id="node-info" aria-live="polite" hidden>
    <h2 id="node-info-name"></h2>
    <ul id="node-info-tags"></ul>
  </aside>
  <output id="graph-coordinates" aria-label="Graph coordinates" hidden></output>
  <div id="graph"></div>

  <script>
    const BASE = "{{ '/' | url }}".replace(/\/$/, '');
    const DEVICE_PATH = '/devices';
    const ROLE_TAG_COLORS = {
      dns: 0xff0000,
      chatserver: 0x00ff00,
      has_dns_name: 0x0000ff
    };
    const DEFAULT_COLOR = 0xababab;
    const MAYBE_CHATSERVER_COLOR = 0x009800;
    const NO_DACS_IP4_COLOR = 0x854585;
    const GROUPS = [
      { tag: 'chatserver', label: 'Chat servers', icon: 'C', color: ROLE_TAG_COLORS.chatserver, x: 90, y: 0 },
      { tag: 'maybe_chatserver', label: 'Maybe chat servers', icon: '?', color: MAYBE_CHATSERVER_COLOR, x: 90, y: -80 },
      { tag: 'dacs_ip4', label: 'DACS IPv4', icon: '4', color: 0x9b7cff, x: 0, y: 100 },
      { tag: 'dns', label: 'DNS', icon: 'D', color: ROLE_TAG_COLORS.dns, x: -100, y: -50 }
    ];
    let groupingMode = 'point';
    let groupingStrength = 0.1;
    let showGroupAnchors = true;
    const LABEL_COMPACT_SCALE = 0.8;
    const LABEL_HIDE_SCALE = 0.5;

    function normalizeTag(tag) {
      return String(tag).trim().replace(/^#+/, '').toLowerCase();
    }

    function colorToRgb(color) {
      return [(color >> 16) & 255, (color >> 8) & 255, color & 255];
    }

    function getNodeTagList(node) {
      const tags = Array.isArray(node.tags) ? node.tags
        : typeof node.tags === 'string' ? node.tags.split(',')
        : [];
      return [...new Set(tags.map(tag => String(tag).trim().replace(/^#+/, '')).filter(Boolean))];
    }

    function normalizeTags(node) {
      return new Set(getNodeTagList(node).map(normalizeTag).filter(Boolean));
    }

    function drawNodeLabel(ctx, label, x, y, globalScale) {
      if (globalScale <= LABEL_HIDE_SCALE) return;

      const compact = globalScale <= LABEL_COMPACT_SCALE;
      ctx.font = `${(compact ? 9 : 12) / globalScale}px Sans-Serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      ctx.fillStyle = compact ? 'rgba(220,221,222,0.45)' : '#dcddde';
      ctx.fillText(label, x, y);
    }

    function colorNode(tags) {
      const roleColors = Object.entries(ROLE_TAG_COLORS)
        .filter(([tag]) => tags.has(tag))
        .map(([, color]) => colorToRgb(color));

      if (roleColors.length > 0) {
        return [0, 1, 2].map(channel =>
          Math.round(roleColors.reduce((total, color) => total + color[channel], 0) / roleColors.length)
        );
      }

      if (!tags.has('dacs_ip4')) return colorToRgb(NO_DACS_IP4_COLOR);
      if (tags.has('maybe_chatserver')) return colorToRgb(MAYBE_CHATSERVER_COLOR);
      return colorToRgb(DEFAULT_COLOR);
    }

    function isInDevicePath(node) {
      let pathname = String(node.url || '').split(/[?#]/, 1)[0];
      try {
        pathname = decodeURI(pathname);
      } catch {
        // Keep the original URL if it contains malformed percent-encoding.
      }
      return pathname === DEVICE_PATH || pathname.startsWith(`${DEVICE_PATH}/`);
    }

    fetch(`${BASE}/graph.json`)
      .then(res => res.json())
      .then(raw => {
        const allNodes = Array.isArray(raw.nodes) ? raw.nodes : Object.values(raw.nodes);
        const deviceNodes = allNodes.filter(isInDevicePath);
        const nodeTags = new Map(deviceNodes.map(node => [node.id, normalizeTags(node)]));
        const nodeTagLists = new Map(deviceNodes.map(node => [node.id, getNodeTagList(node)]));
        const nodeGroups = new Map(deviceNodes.map(node => [
          node.id,
          GROUPS.filter(group => nodeTags.get(node.id).has(group.tag))
        ]));
        const groupAnchors = GROUPS.map(group => ({
          id: `group:${group.tag}`,
          isGroupAnchor: true,
          group,
          title: group.label,
          x: group.x,
          y: group.y,
          fx: group.x,
          fy: group.y,
          val: 4
        }));
        const anchorsByTag = new Map(groupAnchors.map(anchor => [anchor.group.tag, anchor]));
        const nodes = [...deviceNodes, ...groupAnchors];
        const nodeIds = new Set(deviceNodes.map(node => node.id));
        const getNodeId = endpoint => typeof endpoint === 'object' && endpoint !== null ? endpoint.id : endpoint;
        const baseLinks = (raw.links || [])
          .filter(link => nodeIds.has(getNodeId(link.source)) && nodeIds.has(getNodeId(link.target)))
          .map(link => ({ ...link, source: getNodeId(link.source), target: getNodeId(link.target) }));
        const groupingLinks = deviceNodes.flatMap(node =>
          nodeGroups.get(node.id).map(group => ({
            source: node.id,
            target: anchorsByTag.get(group.tag).id,
            isGroupingLink: true,
            group
          }))
        );
        const getGraphLinks = () => [
          ...baseLinks.map(link => ({ ...link })),
          ...(groupingMode === 'node' ? groupingLinks.map(link => ({ ...link })) : [])
        ];
        const nodeInfo = document.getElementById('node-info');
        const nodeInfoName = document.getElementById('node-info-name');
        const nodeInfoTags = document.getElementById('node-info-tags');
        const graphCoordinates = document.getElementById('graph-coordinates');
        const repelInput = document.getElementById('repel');
        const linkStrengthInput = document.getElementById('linkStrength');
        const distanceInput = document.getElementById('dist');
        const centerInput = document.getElementById('center');
        const groupingForceInput = document.getElementById('groupingForce');
        const groupingModeInput = document.getElementById('groupingMode');
        const showGroupAnchorsInput = document.getElementById('showGroupAnchors');
        groupingMode = groupingModeInput.value;
        groupingStrength = Number(groupingForceInput.value);
        showGroupAnchors = showGroupAnchorsInput.checked;

        const Graph = ForceGraph()(document.getElementById('graph'))
          .graphData({ nodes, links: getGraphLinks() })
          .backgroundColor('#1e1e1e')
          .nodeId('id')
          .nodeVal(node => node.isGroupAnchor ? 4 : 1)
          .nodeVisibility(node => !node.isGroupAnchor || (groupingMode !== 'none' && showGroupAnchors))
          .nodeLabel(node => node.title || node.id)
          .linkVisibility(link => !link.isGroupingLink || (groupingMode === 'node' && showGroupAnchors))
          .linkColor(link => link.isGroupingLink
            ? `rgba(${colorToRgb(link.group.color).join(',')},0.65)`
            : 'rgba(255,255,255,0.2)')
          .linkDirectionalArrowLength(link => link.isGroupingLink ? 6 : 4)
          .linkDirectionalArrowRelPos(1)
          .linkDirectionalParticles(link => link.isGroupingLink ? 0 : 1)
          .linkDirectionalParticleSpeed(0.004)
          .nodeCanvasObject((node, ctx, globalScale) => {
            if (node.isGroupAnchor) {
              if (groupingMode === 'none') return;

              ctx.save();
              ctx.fillStyle = `rgb(${colorToRgb(node.group.color).join(',')})`;
              if (groupingMode === 'point') {
                ctx.beginPath();
                ctx.moveTo(node.x, node.y - 10);
                ctx.lineTo(node.x + 10, node.y);
                ctx.lineTo(node.x, node.y + 10);
                ctx.lineTo(node.x - 10, node.y);
                ctx.closePath();
                ctx.fill();
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 1 / globalScale;
                ctx.stroke();
                ctx.fillStyle = '#1e1e1e';
                ctx.font = `bold ${10 / globalScale}px Sans-Serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(node.group.icon, node.x, node.y);
              } else {
                ctx.beginPath();
                ctx.arc(node.x, node.y, 3, 0, 2 * Math.PI, false);
                ctx.fill();
                drawNodeLabel(ctx, node.group.label, node.x, node.y + 7, globalScale);
              }
              ctx.restore();
              return;
            }

            const label = node.title || node.id;
            ctx.beginPath();
            ctx.arc(node.x, node.y, 3, 0, 2 * Math.PI, false);
            ctx.fillStyle = `rgb(${colorNode(nodeTags.get(node.id)).join(',')})`;
            ctx.fill();
            drawNodeLabel(ctx, label, node.x, node.y + 7, globalScale);
          })
          .onNodeHover(node => {
            if (!node) {
              nodeInfo.hidden = true;
              return;
            }

            nodeInfoName.textContent = node.isGroupAnchor
              ? `${node.group.label} group center`
              : node.title || node.url || String(node.id);
            nodeInfoTags.replaceChildren();
            const tags = node.isGroupAnchor
              ? [`# ${node.group.tag}`, 'Drag to move this group center']
              : nodeTagLists.get(node.id) || [];
            if (tags.length === 0) {
              const item = document.createElement('li');
              item.textContent = 'No tags';
              nodeInfoTags.appendChild(item);
            } else {
              for (const tag of tags) {
                const item = document.createElement('li');
                item.textContent = tag;
                nodeInfoTags.appendChild(item);
              }
            }
            nodeInfo.hidden = false;
          })
          .onNodeDrag(node => {
            if (node.isGroupAnchor) {
              node.fx = node.x;
              node.fy = node.y;
            }
          })
          .onNodeDragEnd(node => {
            if (node.isGroupAnchor) {
              node.fx = node.x;
              node.fy = node.y;
            }
          })
          .onNodeClick(node => {
            if (!node.url) return;
            const target = `${BASE}${node.url.startsWith('/') ? node.url : `/${node.url}`}`;
            window.location.href = target;
          });

        const initialRepel = Number(repelInput.value);
        const initialLinkDistance = Number(distanceInput.value);
        const initialCenter = Number(centerInput.value);
        const updateLinkStrengths = () => {
          Graph.d3Force('link').strength(link => link.isGroupingLink
            ? groupingStrength
            : Number(linkStrengthInput.value));
        };
        Graph.d3Force('charge').strength(node => node.isGroupAnchor ? 0 : -initialRepel);
        updateLinkStrengths();
        Graph.d3Force('link').distance(initialLinkDistance);
        Graph.d3Force('x', d3.forceX(0).strength(initialCenter));
        Graph.d3Force('y', d3.forceY(0).strength(initialCenter));

        const graphCanvas = document.querySelector('#graph canvas');
        let pointerPosition = null;
        const updateGraphCoordinates = () => {
          if (!pointerPosition) return;

          const bounds = graphCanvas.getBoundingClientRect();
          const center = Graph.centerAt();
          const scale = Graph.zoom();
          const x = center.x + (pointerPosition.x - bounds.left - bounds.width / 2) / scale;
          const y = center.y + (pointerPosition.y - bounds.top - bounds.height / 2) / scale;
          graphCoordinates.textContent = `x: ${x.toFixed(1)}  y: ${y.toFixed(1)}`;
        };
        graphCanvas.addEventListener('pointermove', event => {
          pointerPosition = { x: event.clientX, y: event.clientY };
          graphCoordinates.hidden = false;
          updateGraphCoordinates();
        });
        graphCanvas.addEventListener('pointerleave', () => {
          pointerPosition = null;
          graphCoordinates.hidden = true;
        });
        Graph.onZoom(updateGraphCoordinates);

        const groupForce = alpha => {
          if (groupingMode !== 'point' || groupingStrength === 0) return;

          for (const node of deviceNodes) {
            const groups = nodeGroups.get(node.id);
            if (!groups.length || node.x == null || node.y == null) continue;

            const targetX = groups.reduce((total, group) => total + anchorsByTag.get(group.tag).x, 0) / groups.length;
            const targetY = groups.reduce((total, group) => total + anchorsByTag.get(group.tag).y, 0) / groups.length;
            node.vx += (targetX - node.x) * groupingStrength * alpha;
            node.vy += (targetY - node.y) * groupingStrength * alpha;
          }
        };
        Graph.d3Force('grouping', groupForce);

        repelInput.addEventListener('input', e => {
          const val = Number(e.target.value);
          document.getElementById('repelVal').textContent = `-${val}`;
          Graph.d3Force('charge').strength(node => node.isGroupAnchor ? 0 : -val);
          Graph.d3ReheatSimulation();
        });

        linkStrengthInput.addEventListener('input', e => {
          const val = Number(e.target.value);
          document.getElementById('linkStrengthVal').textContent = val;
          updateLinkStrengths();
          Graph.d3ReheatSimulation();
        });

        distanceInput.addEventListener('input', e => {
          const val = Number(e.target.value);
          document.getElementById('distVal').textContent = val;
          Graph.d3Force('link').distance(val);
          Graph.d3ReheatSimulation();
        });

        centerInput.addEventListener('input', e => {
          const val = Number(e.target.value);
          document.getElementById('centerVal').textContent = val;
          Graph.d3Force('x', d3.forceX(0).strength(val));
          Graph.d3Force('y', d3.forceY(0).strength(val));
          Graph.d3ReheatSimulation();
        });

        groupingForceInput.addEventListener('input', e => {
          groupingStrength = Number(e.target.value);
          document.getElementById('groupingForceVal').textContent = groupingStrength.toFixed(2);
          updateLinkStrengths();
          Graph.d3ReheatSimulation();
        });

        const updateGroupingVisibility = () => {
          Graph.nodeVisibility(node => !node.isGroupAnchor || (groupingMode !== 'none' && showGroupAnchors));
          Graph.linkVisibility(link => !link.isGroupingLink || (groupingMode === 'node' && showGroupAnchors));
          Graph.d3ReheatSimulation();
        };

        groupingModeInput.addEventListener('change', e => {
          groupingMode = e.target.value;
          Graph.graphData({ nodes, links: getGraphLinks() });
          updateGroupingVisibility();
        });

        showGroupAnchorsInput.addEventListener('change', e => {
          showGroupAnchors = e.target.checked;
          updateGroupingVisibility();
        });
      });
  </script>
</body>
</html>
